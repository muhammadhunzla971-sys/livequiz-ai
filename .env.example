# Copy to .env and fill in. Never commit .env.

ENV=dev
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Docker-compose overrides these for the api container; set them for local (non-Docker) runs.
DATABASE_URL=postgresql+asyncpg://livequiz:livequiz@localhost:5432/livequiz
REDIS_URL=redis://localhost:6379/0

# Number of reverse proxies in front of the API (1 on Render/Railway, 0 locally).
TRUSTED_PROXY_HOPS=0

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# LLM: any OpenAI-compatible provider (default: Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Limits
GENERATION_RATE_PER_HOUR=20
MAX_PLAYERS_PER_ROOM=300
SESSION_RETENTION_DAYS=90
